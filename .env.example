# Copy to .env and fill in. config/settings.py reads these (names are case-insensitive).
# Required values have no default in Settings; the app refuses to start without them.

# ---- API ----
# Required. Clients send it in the x-api-key header.
API_KEY=your-secret-api-key-here
# Instead of API_KEY, point API_KEY_FILE at a mounted secret file, such as a
# Cloud Run Secret Manager volume. A set API_KEY wins over the file.
# API_KEY_FILE=/secrets/api-key
PORT=8080
# true enables /docs, allows every CORS origin, and lets requests through without a key.
DEBUG=true
# development, staging or production. Startup fails when this is production and DEBUG=true.
ENVIRONMENT=development
LOG_LEVEL=INFO
# json for Cloud Run and log pipelines, console for coloured local output.
LOG_FORMAT=console
# Sentry DSN for error tracking. Leave empty to send nothing.
ERROR_TRACKING_DSN=

# ---- Google Cloud / Vertex AI ----
# Required.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Path to a service account key. Leave unset to use gcloud application-default credentials.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# ---- Firestore session store ----
# Sessions each in-memory cache keeps before dropping the least recently used.
# Firestore still holds evicted sessions, so they come back on their next turn.
SESSION_CACHE_MAX_ENTRIES=10000
FIRESTORE_COLLECTION=conversations
# Set to use the local emulator from `docker compose --profile emulator up`.
# FIRESTORE_EMULATOR_HOST=localhost:8085

# ---- Gemini models ----
FLASH_MODEL=gemini-3-flash-preview
PRO_MODEL=gemini-3-flash-preview
FALLBACK_FLASH_MODEL=gemini-2.5-flash
FALLBACK_PRO_MODEL=gemini-2.5-pro
LLM_TEMPERATURE=0.7
# Per-model timeout. The evaluator allows 30s per turn.
API_TIMEOUT_SECONDS=12
GEMINI_MAX_RETRIES=0
GEMINI_RETRY_DELAY_SECONDS=0.5
# How many recent turns go into the agent prompt.
CONTEXT_WINDOW_TURNS=8

# ---- Engagement policy ----
MAX_ENGAGEMENT_TURNS_CAUTIOUS=10
MAX_ENGAGEMENT_TURNS_AGGRESSIVE=25
MAX_ENGAGEMENT_DURATION_SECONDS=600
CAUTIOUS_CONFIDENCE_THRESHOLD=0.60
AGGRESSIVE_CONFIDENCE_THRESHOLD=0.85

# ---- Rate limiting (read by Settings, not enforced by middleware yet) ----
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---- GUVI evaluator callback ----
# The API posts final intelligence here after each scam turn. Keep it off locally.
GUVI_CALLBACK_ENABLED=false
GUVI_CALLBACK_URL=https://hackathon.guvi.in/api/updateHoneyPotFinalResult
GUVI_CALLBACK_TIMEOUT=10.0

# ---- Evaluation tooling (gk-testing/, simulated-testing/) ----
# These scripts drive a running API and are never used by the API itself.
EVAL_API_URL=http://localhost:8080
EVAL_API_KEY=your-secret-api-key-here
STICKY_NET_URL=http://localhost:8080
# Key the `pytest -m integration` live tests send. Defaults to the evaluator key.
TEST_API_KEY=your-secret-api-key-here

# ---- Scammer simulator in tester/ (python tester/app.py) ----
# tester/.env.example holds the same values; the API never reads these.
# Model that plays the scammer.
SCAMMER_MODEL=gemini-2.5-flash
# false uses GEMINI_API_KEY instead of Vertex AI credentials.
USE_VERTEXAI=true
GEMINI_API_KEY=
# Seconds the simulator waits for each API reply.
REQUEST_TIMEOUT=30

# ---- Dashboard in frontend/ ----
# These belong in frontend/.env.development.local or frontend/.env.production.local,
# see frontend/.env.example. CRA compiles REACT_APP_* into the public bundle.
REACT_APP_API_URL=http://localhost:8080
REACT_APP_API_KEY=dev-api-key
# true adds the webpack health endpoints during `yarn start`.
ENABLE_HEALTH_CHECK=false
# The CRA scripts set this themselves (development, test or production).
NODE_ENV=development
