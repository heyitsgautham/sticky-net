# Copy to frontend/.env.development.local (yarn start) or frontend/.env.production.local (yarn build).
# CRA bakes REACT_APP_* values into the JavaScript bundle, so never put a real secret here.

# Base URL of the Sticky-Net API.
REACT_APP_API_URL=http://localhost:8080
# Sent as x-api-key. Must match the API's API_KEY, or the API must run with DEBUG=true.
REACT_APP_API_KEY=dev-api-key

# Dev server port for `yarn start`.
PORT=3000
# true adds the webpack health endpoints from plugins/health-check during `yarn start`.
ENABLE_HEALTH_CHECK=false
